# ДЕЛО Marketplace - Environment Configuration

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# ENV=development — локальная разработка: включаются демо-пополнение кошелька,
# dev-ссылка сброса пароля и авто-генерация SECRET_KEY.
# Любое другое значение (или отсутствие переменной) считается production:
# CSRF и лимиты включаются, без SECRET_KEY приложение не стартует.
ENV=development

# Database
DATABASE_URL=sqlite:///./marketplace_v3.db

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Admin emails (comma-separated).
# ОБЯЗАТЕЛЬНО: дефолта нет — при пустом значении модераторов не будет вовсе.
ADMIN_EMAILS=

# Redis (optional, for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Celery (optional, for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# SMTP (optional): письма восстановления пароля и подтверждения почты.
# Пустые — письма не уходят, а ссылки (сброс пароля, подтверждение почты)
# в режиме ENV=development приходят прямо в ответе API. Заглушки вроде
# your-email@gmail.com сюда не пишите: с ними почта считается настроенной,
# ссылок в ответе нет, а письма не доходят.
# Боевой пример (российский SMTP, Яндекс 360): SMTP_HOST=smtp.yandex.ru,
# SMTP_PORT=465, SMTP_USER=noreply@ваш-домен, SMTP_PASS=пароль приложения.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sentry (optional, for error tracking)
SENTRY_DSN=

# ЮKassa (optional, for payments)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ЮMoney (optional, for payments)
YOOMONEY_CLIENT_ID=your_client_id_here
YOOMONEY_CLIENT_SECRET=your_client_secret_here
YOOMONEY_ACCESS_TOKEN=your_access_token_here
YOOMONEY_REDIRECT_URI=http://localhost:8000/api/payments/oauth/yoomoney
YOOMONEY_NOTIFICATION_SECRET=generate-with-openssl-rand-hex-32

# Query monitoring (optional)
ENABLE_QUERY_MONITORING=false
