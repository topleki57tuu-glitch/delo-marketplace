# ===== Backend (FastAPI) =====
# Окружение: development | production (в production демо-пополнение кошелька отключено)
ENV=development
# Секрет JWT — ОБЯЗАТЕЛЬНЫЙ в production (без него бэкенд откажется стартовать).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_random_string
ALGORITHM=HS256
# SQLite для dev; для production: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./marketplace_v3.db
API_HOST=0.0.0.0
API_PORT=8000
# Разрешённые источники CORS через запятую — ОБЯЗАТЕЛЬНО в production
# (wildcard "*" больше не поддерживается: API работает с деньгами и авторизацией)
CORS_ORIGINS=http://localhost:3000

# ===== Ограничение частоты запросов =====
# В production лимиты включены всегда. В разработке по умолчанию выключены,
# чтобы не мешать тестам — включить для проверки: RATE_LIMIT_ENABLED=1
RATE_LIMIT_ENABLED=
# Хранилище счётчиков. Без него лимиты считаются в памяти процесса и не
# разделяются между воркерами — реальный порог умножается на их число.
# Для docker-compose: redis://redis:6379/0
REDIS_URL=

# ===== PostgreSQL (docker-compose) =====
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change_me
POSTGRES_DB=marketplace_db

# ===== Telegram-бот «Радар заказов» (bot/bot.py) =====
# Внимание: бот читает именно TG_BOT_TOKEN / API_URL / FRONTEND_URL
TELEGRAM_BOT_TOKEN=
TG_BOT_TOKEN=
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ===== Geocoding (Яндекс, опционально — есть fallback по городам) =====
YANDEX_GEOCODER_API_KEY=
GEOCODING_USER_AGENT=DELO-Marketplace/2.0

# ===== SMTP для писем сброса пароля (опционально) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== ЮKassa для реальных платежей (опционально; иначе демо-пополнение) =====
# Ключи из кабинета https://yookassa.ru/ (для теста есть тестовый магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты (страница профиля фронтенда)
PAYMENT_RETURN_URL=http://localhost:3000/profile
# Тестовая карта (test-режим): 5555 5555 5555 4444, любой срок/CVC

# ===== ЮMoney (опционально; провайдер по умолчанию в /payments/create) =====
# ACCESS_TOKEN получается через OAuth: https://yoomoney.ru/myservices/online/create
# Без него запросы к ЮMoney отвечают 400 «ЮMoney не настроен».
YOOMONEY_ACCESS_TOKEN=
YOOMONEY_CLIENT_ID=
YOOMONEY_REDIRECT_URI=
# Секрет для проверки подписи вебхука (POST /payments/webhook/yoomoney).
# Без него вебхук возвращает 403 и платежи не зачисляются.
YOOMONEY_NOTIFICATION_SECRET=

# ===== Демо-данные (ТОЛЬКО development) =====
# SEED_DEMO=1 засеивает базу примерами при старте. В production игнорируется:
# среди демо-аккаунтов есть администратор.
SEED_DEMO=
# Пароль демо-аккаунтов. Если не задан — генерируется случайный и печатается в лог.
DEMO_PASSWORD=

# ===== Арбитраж (споры по сделкам) =====
# Email-адреса арбитров платформы через запятую — они видят /admin/disputes и выносят решения.
# ОБЯЗАТЕЛЬНО в production: без этой переменной модераторов нет ни одного
# (дефолта больше нет — иначе админом становился любой, кто занял адрес из примера).
ADMIN_EMAILS=
